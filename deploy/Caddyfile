(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

{$DOMAIN} {
	import common
	reverse_proxy app:8787
}

admin.{$DOMAIN} {
	import common
	reverse_proxy app:8788
}

dev.{$DOMAIN} {
	import common
	reverse_proxy app-dev:8787
}

admin.dev.{$DOMAIN} {
	import common
	reverse_proxy app-dev:8788
}
