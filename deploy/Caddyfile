(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

{$DOMAIN}, {$DOMAIN}:8444 {
	import common
	reverse_proxy app:8787
}

{$DOMAIN}:8443 {
	import common
	reverse_proxy app:8788
}

{$DOMAIN}:9444 {
	import common
	reverse_proxy app-dev:8787
}

{$DOMAIN}:9443 {
	import common
	reverse_proxy app-dev:8788
}
